PORT=8080
FIXTURE_BASE_URL=http://localhost:8080

# Built-in fake OAuth provider used by /oauth/*
FIXTURE_OAUTH_CLIENT_ID=apitrench-client
FIXTURE_OAUTH_CLIENT_SECRET=apitrench-secret

# Real Google OAuth client used by /real-oauth/google/login and /real-oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/real-oauth/google/callback

# Real GitHub OAuth client used by /real-oauth/github/login and /real-oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/real-oauth/github/callback
